networks:
  voip-net:
    driver: bridge

services:
  # Asterisk — WebRTC + SIP.UP trunk
  asterisk:
    build:
      context: .
      dockerfile: asterisk/Dockerfile
    container_name: clawcall-asterisk
    restart: unless-stopped
    network_mode: host
    deploy:
      resources:
        limits:
          memory: 1G

  # Backend — Python API + Frontend
  backend:
    build:
      context: .
      dockerfile: Dockerfile.backend
    container_name: clawcall-backend
    restart: unless-stopped
    ports:
      - "8090:8090"
    environment:
      - API_PORT=8090
      - DOMAIN=hushcircuits.online
      - PUBLIC_IP=18.223.24.42
      - SUPABASE_URL=https://ejbdrsgciqwvanskckov.supabase.co
      - SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVqYmRyc2djaXF3dmFuc2tja292Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzI1NjQzMiwiZXhwIjoyMDkyODMyNDMyfQ.pPB81lB8Nusj8zmTYTq6UFfVj9uOqUFcchiwTiYHSjQ
      - SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVqYmRyc2djaXF3dmFuc2tja292Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyNTY0MzIsImV4cCI6MjA5MjgzMjQzMn0.B2C-oc1Z9h-hnNE63kLUGMWNSTuc80NUhkGo30crEms
      - NOWPAYMENTS_API_KEY=9ED8ZNB-1ZNMGM6-J92MPHH-BA68DV7
      - SIPUP_USERNAME=10428
      - SIPUP_PASSWORD=tjmoVhp4zUZp4x
      - ADMIN_USERNAME=dysthemix
      - PRICE_PER_MINUTE=0.50
      - VIP_WEEKLY_PRICE=250.00
      - COOKIE_SECRET=clawcall-dev-secret-change-in-production
    volumes:
      - ./server.py:/app/server.py
      - ./frontend:/app/frontend
    networks:
      - voip-net

  # Nginx — Reverse Proxy + TLS
  nginx:
    image: nginx:alpine
    container_name: clawcall-nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/certs:/etc/nginx/certs
    networks:
      - voip-net
    depends_on:
      - backend

  certbot:
    image: certbot/certbot
    container_name: clawcall-certbot
    volumes:
      - ./nginx/certs:/etc/letsencrypt
      - ./frontend:/var/www/certbot
    entrypoint: >-
      sh -c "trap exit TERM; while :; do
        certbot renew --webroot -w /var/www/certbot --quiet;
        sleep 12h & wait $$!;
      done"
