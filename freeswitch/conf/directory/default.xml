<include>
  <!--
    Minimal Directory
    Defines the domain for ClawCall.
    Users register dynamically via SIP REGISTER (no static user definitions needed).
  -->
  <domain name="$${domain}">
    <params>
      <param name="dial-string" value="{presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(${dialed_user}@${dialed_domain})}"/>
      <param name="jsonrpc-allowed-names" value="*"/>
    </params>

    <groups>
      <group name="default">
        <users>
          <!-- Users register dynamically, no static entries -->
        </users>
      </group>
    </groups>
  </domain>
</include>
