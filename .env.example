# ClawCall VoIP – Environment Variables
# Copy this file to .env and fill in your values.

# Domain
DOMAIN=hushcircuits.online

# Public IP address of the server (for FreeSWITCH RTP)
PUBLIC_IP=CHANGE_ME_TO_YOUR_PUBLIC_IP

# FreeSWITCH ESL
FS_HOST=clawcall-fs
FS_PORT=8021
FS_PASSWORD=ClueCon

# SIP.UP Trunk Credentials
SIPUP_SERVER=sip.sipup.org
SIPUP_PORT=5060
SIPUP_USERNAME=10428
SIPUP_PASSWORD=CHANGE_ME

# TURN Server Credentials
TURN_SERVER=turn:hushcircuits.online:3478
TURN_USERNAME=clawcall
TURN_PASSWORD=CHANGE_ME
